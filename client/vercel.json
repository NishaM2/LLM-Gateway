{
  "rewrites": [
    { "source": "/stats/:path*", "destination": "https://YOUR-RENDER-APP.onrender.com/stats/:path*" },
    { "source": "/v1/:path*", "destination": "https://YOUR-RENDER-APP.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://YOUR-RENDER-APP.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
