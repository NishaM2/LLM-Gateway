# Copy this file to .env and fill in the values. Never commit .env.

# Port the gateway listens on. Optional, defaults to 3000.
PORT=3000

# Postgres connection. Step 5 starts this database with Docker.
DATABASE_URL=postgres://gateway:gateway@localhost:5433/gateway

# Provider API keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. Point Groq at a different OpenAI compatible endpoint, for example a
# local server that fails on purpose while testing retries.
# GROQ_BASE_URL=http://localhost:4010/v1
