{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible LLM gateway with caching, routing and cost tracking",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "tenant:create": "tsx src/scripts/createTenant.ts",
    "redis:check": "tsx src/scripts/checkRedis.ts",
    "cache:flush": "tsx src/scripts/flushNamespace.ts",
    "semantic:check": "tsx src/scripts/checkSemanticCache.ts",
    "embeddings:check": "tsx src/scripts/checkEmbeddings.ts",
    "eval:sweep": "tsx evals/sweep.ts",
    "eval:sweep:guards": "tsx evals/sweep.ts --guards",
    "dashboard": "cd client && npm run dev",
    "dashboard:install": "cd client && npm install",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
